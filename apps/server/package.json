{
  "name": "@config-manager/server",
  "version": "0.1.0",
  "description": "Standalone API server (runs independently from Nuxt frontend)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@config-manager/api": "workspace:*",
    "effect": "^3.19.15",
    "@effect/platform": "^0.94.2",
    "@effect/platform-node": "^0.104.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
